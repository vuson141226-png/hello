# Server-only configuration. Copy to .env.local; never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# auto recognizes raw JWT / modern keys. Use legacy for opaque proxy-bound JWT keys.
# This is a non-secret setting; never expose it or server credentials through VITE_.
SUPABASE_KEY_FORMAT=auto
